template <class T> 
void select(T* a, int n) { 
 int i, j, c; 
 T t; 
 bool exchange = false; 
 for (i = 0; i < n - 1; i++) { 
  exchange = 0; 
  t = a[i]; 
  for (j = i + 1; j < n; j++) { 
   if (a[j] < t) { 
    exchange = 1; 
    c = j; 
    t = a[j]; 
   } 
  } 
  if (exchange) { 
   a[c] = a[i]; 
   a[i] = t; 
  } 
 } 
} 
